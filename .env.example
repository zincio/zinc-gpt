# AI Provider (choose one)
# Option 1: Call Anthropic directly. Get a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# Option 2: Route through Vercel AI Gateway instead (leave ANTHROPIC_API_KEY empty)
# AI_GATEWAY_API_KEY=

# Optional model tuning (defaults shown)
# ANTHROPIC_MODEL=claude-opus-5        # e.g. claude-sonnet-5 for a cheaper/faster tier
# ANTHROPIC_EFFORT=low                 # low | medium | high | xhigh | max

# Zinc MCP - chat search and checkout go through https://mcp.zinc.com/mcp
# No key needed: search is free and shoppers pay by card on Zinc's payment page.
# ZINC_MCP_URL=https://mcp.zinc.com/mcp

# Zinc API - only for the legacy Stripe checkout path below
# Get your API key at https://app.zinc.com (search is billed to your Zinc wallet)
ZINC_API_KEY=
# Webhook secret from the Zinc dashboard (Settings -> Webhooks), format zn_whsec_...
ZINC_WEBHOOK_SECRET=

# Stripe - legacy checkout path only (not used by the chat on this branch)
# Get your keys at https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
