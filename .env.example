# AI Provider (choose one)
# Option 1: Use Anthropic directly
ANTHROPIC_API_KEY=

# Option 2: Use AI Gateway (if you have one)
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=

# Zinc - Required for order fulfillment
# Get your API key at https://zinc.io
ZINC_API_KEY=
ZINC_WEBHOOK_SECRET=

# Stripe - Required for payments
# Get your keys at https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SerpAPI - Required for product search
# Get your API key at https://serpapi.com
SERPAPI_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
